# ============================================================
# Copia este archivo como .env y ajusta los valores
# cp .env.example .env
# ============================================================

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot123

# ============================================================
# N8N
# ============================================================
WEBHOOK_URL=http://localhost:5678
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Europe/Madrid
N8N_LOG_LEVEL=info

# ============================================================
# Frontend (Vite)
# Usar /webhook-test/chatbot en desarrollo (workflow no activado)
# Usar /webhook/chatbot en producción (workflow activado)
# ============================================================
VITE_N8N_WEBHOOK_URL=/webhook-test/chatbot
