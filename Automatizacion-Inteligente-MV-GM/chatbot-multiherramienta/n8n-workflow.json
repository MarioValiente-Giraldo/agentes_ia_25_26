        "jsCode": "const msg = $input.first().json.body.message.toLowerCase();\n\nconst keywords = {\n  clima:     ['tiempo', 'clima', 'lluvia', 'temperatura', 'sol', 'viento', 'nieve', 'calor', 'frio', 'frío', 'meteorolog', 'pronóstico', 'pronostico', 'grados'],\n  pais:      ['país', 'pais', 'capital', 'población', 'poblacion', 'moneda', 'idioma', 'continente', 'nación', 'nacion', 'bandera'],\n  wikipedia: ['quién es', 'quien es', 'qué es', 'que es', 'cuéntame sobre', 'cuentame sobre', 'historia de', 'información sobre', 'informacion sobre', 'háblame de', 'hablame de']\n};\n\nconst found = Object.entries(keywords).find(([, words]) => words.some(w => msg.includes(w)));\nconst intencion = found ? found[0] : 'general';\n\nreturn [{ json: { body: $input.first().json.body, intencion } }];"
      },
