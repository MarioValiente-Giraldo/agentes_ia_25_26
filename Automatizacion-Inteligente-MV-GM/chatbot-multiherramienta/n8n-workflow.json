        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'llama3.2:1b', prompt: 'Del siguiente mensaje extrae SOLO el nombre del país mencionado. Responde ÚNICAMENTE con el nombre del país en español, sin puntuación ni explicación.\\nEjemplos:\\nMensaje: Qué idioma hablan en Brasil -> Brasil\\nMensaje: cuál es la capital de Japón -> Japón\\nMensaje: dime sobre Francia -> Francia\\nMensaje: ' + $('Webhook Chat').item.json.body.message, stream: false }) }}",
        "options": {}
