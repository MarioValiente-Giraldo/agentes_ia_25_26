    {
      "parameters": {
        "jsCode": "const d = Array.isArray($input.first().json) ? $input.first().json[0] : $input.first().json;\n\nconst resumen = {\n  nombre: d.name?.common,\n  nombreOficial: d.name?.official,\n  capital: d.capital?.[0],\n  region: d.region,\n  subregion: d.subregion,\n  poblacion: d.population,\n  idiomas: d.languages ? Object.values(d.languages) : [],\n  moneda: d.currencies ? Object.values(d.currencies).map(c => c.name + ' (' + c.symbol + ')') : [],\n  bandera: d.flag,\n  area: d.area,\n  continente: d.continents?.[0],\n};\n\nreturn [{ json: resumen }];"
      },
