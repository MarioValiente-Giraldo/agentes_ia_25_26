      "id": "cc111111-1111-1111-1111-cc1111111111",
      "name": "Extraer País",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1040, 1104]
    },
    {
      "parameters": {
        "jsCode": "const msg = $('Webhook Chat').item.json.body.message;\n\nconst patrones = [\n  /(?:cuéntame|cuentame|háblame|hablame)\\s+(?:sobre|de)\\s+(.+)/i,\n  /(?:información|informacion)\\s+(?:sobre|de)\\s+(.+)/i,\n  /(?:historia de)\\s+(.+)/i,\n  /(?:quién es|quien es|qué es|que es)\\s+(.+)/i,\n  /(?:sobre|acerca de)\\s+(.+)/i,\n];\n\nlet entidad = msg;\nfor (const patron of patrones) {\n  const match = msg.match(patron);\n  if (match) { entidad = match[1].trim(); break; }\n}\n\nreturn [{ json: { entidad } }];"
      },
